+++ b/tests/unit/test_openbot_setup.mm
@@ -0,0 +1,55 @@
+// OpenBot additions to Sunshine, distributed under GPL-3.0.
+#import <AppKit/AppKit.h>
+#include <stdexcept>
+#include "../../src/platform/macos/openbot_setup.mm"
+namespace platf { bool is_screen_capture_allowed() { return false; } }
+#define require(condition) do { if (!(condition)) throw std::runtime_error(#condition); } while (false)
+int main() {
+  @autoreleasepool {
+    [NSApplication sharedApplication];
+    [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+    [NSApp finishLaunching];
+    platf::openbot_test_action("start");
+    require(platf::openbot_test_status()["active"] == true);
+    require(!panel.movable);
+    auto view = (OpenBotTestView *)panel.contentView;
+    CGEventRef native = CGEventCreateKeyboardEvent(nullptr, 18, true);
+    NSEvent *event = [NSEvent eventWithCGEvent:native];
+    require(![view remoteEvent:event]);
+    [view keyDown:event];
+    require(platf::openbot_test_status()["keyboard"] == false);
+    CGEventSetIntegerValueField(native, kCGEventSourceUserData, event_tag);
+    event = [NSEvent eventWithCGEvent:native];
+    require([view remoteEvent:event]);
+    CGEventSetIntegerValueField(native, kCGEventSourceUnixProcessID, getpid() + 1);
+    event = [NSEvent eventWithCGEvent:native];
+    require(![view remoteEvent:event]);
+    CFRelease(native);
+    CGEventRef mouse = CGEventCreateMouseEvent(nullptr, kCGEventLeftMouseDown, CGPointZero, kCGMouseButtonLeft);
+    NSEvent *click = [NSEvent eventWithCGEvent:mouse];
+    [view acceptMouse:click point:NSMakePoint(50, 130)];
+    require(!clicked);
+    CGEventSetIntegerValueField(mouse, kCGEventSourceUserData, event_tag);
+    click = [NSEvent eventWithCGEvent:mouse];
+    [view acceptMouse:click point:NSMakePoint(0, 0)];
+    require(!clicked);
+    [view acceptMouse:click point:NSMakePoint(50, 130)];
+    require(clicked);
+    CGEventRef key = CGEventCreateKeyboardEvent(nullptr, 18, true);
+    for (NSUInteger i = 0; i < code.length; i++) {
+      [view acceptKey:[NSEvent eventWithCGEvent:key] characters:[code substringWithRange:NSMakeRange(i, 1)]];
+    }
+    require(!typed);
+    CGEventSetIntegerValueField(key, kCGEventSourceUserData, event_tag);
+    for (NSUInteger i = 0; i < code.length; i++) {
+      [view acceptKey:[NSEvent eventWithCGEvent:key] characters:[code substringWithRange:NSMakeRange(i, 1)]];
+    }
+    require(typed);
+    CFRelease(mouse);
+    CFRelease(key);
+    platf::openbot_test_action("stop");
+    require(platf::openbot_test_status()["active"] == false);
+    require(!test_mode);
+    puts("Native test: local input rejected; marked Sunshine input recognized; panel cleanup passed.");
+  }
+}
