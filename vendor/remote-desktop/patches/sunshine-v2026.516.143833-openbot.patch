+    return {{"screenRecording", capture ? "allowed" : "blocked"},
+      {"accessibility", AXIsProcessTrusted() ? "allowed" : "blocked"},
+      {"guiSession", gui ? "allowed" : "blocked"},
+      {"displays", display_result == kCGErrorSuccess ? (count > 0 ? "allowed" : "unavailable") : "failed"},
+      {"restartRequired", capture && !is_screen_capture_allowed()},
+      {"username", std::string([NSUserName() UTF8String])},
