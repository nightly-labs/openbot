+
+  nlohmann::json openbot_test_status() {
+    __block nlohmann::json result;
+    on_main(^{
+      result = {{"active", panel != nil && panel.visible}, {"mouse", clicked}, {"keyboard", typed}, {"code", std::string([code UTF8String])}};
+    });
+    return result;
+  }
+
+  void openbot_test_action(const std::string &action, const std::string &display_id) {
+    on_main(^{
+      if (action == "stop") {
+        [panel close];
+        panel = nil;
+        expires = nil;
+        std::lock_guard<std::mutex> lock(input_mutex);
+        test_mode = false;
+        event_tag = 0;
+        return;
+      }
+      if (panel) return;
+      code = [NSString stringWithFormat:@"%04u", arc4random_uniform(10000)];
+      entered = @"";
+      clicked = typed = false;
+      panel = [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, 480, 290) styleMask:NSWindowStyleMaskTitled backing:NSBackingStoreBuffered defer:NO];
+      panel.releasedWhenClosed = NO;
+      panel.movable = NO;
+      panel.title = @"OpenBot remote desktop test";
+      panel.level = NSFloatingWindowLevel;
+      panel.contentView = [[OpenBotTestView alloc] initWithFrame:NSMakeRect(0, 0, 480, 290)];
+      NSScreen *target = NSScreen.screens.firstObject;
+      for (NSScreen *screen in NSScreen.screens) {
+        if (std::string([screen.deviceDescription[@"NSScreenNumber"] stringValue].UTF8String) == display_id) target = screen;
+      }
+      [panel setFrameOrigin:NSMakePoint(NSMidX(target.frame) - panel.frame.size.width / 2, NSMidY(target.frame) - panel.frame.size.height / 2)];
+      [panel makeKeyAndOrderFront:nil];
+      [panel makeFirstResponder:panel.contentView];
+      [NSApp activateIgnoringOtherApps:YES];
+      expires = [NSDate dateWithTimeIntervalSinceNow:120];
+      std::lock_guard<std::mutex> lock(input_mutex);
+      event_tag = ((int64_t)arc4random() << 20) | arc4random_uniform(1 << 20);
+      const auto frame = panel.frame;
+      const auto main_height = NSScreen.screens.firstObject.frame.size.height;
+      test_bounds = CGRectMake(frame.origin.x, main_height - NSMaxY(frame), frame.size.width, frame.size.height);
+      test_mode = true;
+    });
+  }
+
+  bool openbot_test_input(CGEventRef event) {
+    std::lock_guard<std::mutex> lock(input_mutex);
+    if (!test_mode) return false;
+    auto type = CGEventGetType(event);
+    if (type == kCGEventKeyDown || type == kCGEventKeyUp) {
+      auto key = CGEventGetIntegerValueField(event, kCGKeyboardEventKeycode);
+      // Only the ten digit keys; shortcuts cannot reach another application.
+      if (key != 18 && key != 19 && key != 20 && key != 21 && key != 23 && key != 22 && key != 26 && key != 28 && key != 25 && key != 29) return true;
+    } else if (type == kCGEventLeftMouseDown || type == kCGEventLeftMouseUp || type == kCGEventMouseMoved) {
+      if (!CGRectContainsPoint(test_bounds, CGEventGetLocation(event))) return true;
+    } else return true;
+    CGEventSetFlags(event, 0);
+    CGEventSetIntegerValueField(event, kCGEventSourceUserData, event_tag);
+    CGEventPostToPid(getpid(), event);
+    return true;
+  }
+
+  void openbot_main_loop(const std::function<bool()> &stopped) {
+    @autoreleasepool {
+      [NSApplication sharedApplication];
+      [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+      [NSApp finishLaunching];
+      while (!stopped()) {
+        @autoreleasepool {
+          NSEvent *event = [NSApp nextEventMatchingMask:NSEventMaskAny untilDate:[NSDate dateWithTimeIntervalSinceNow:0.1] inMode:NSDefaultRunLoopMode dequeue:YES];
+          if (event) [NSApp sendEvent:event];
+          [NSApp updateWindows];
+          if (expires && expires.timeIntervalSinceNow <= 0) {
+            [panel close];
+            expires = nil;
+          }
+        }
+      }
+      [panel close];
+    }
+  }
+}
