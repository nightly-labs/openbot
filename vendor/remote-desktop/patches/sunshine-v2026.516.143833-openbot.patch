diff --git a/src/platform/macos/openbot_setup.mm b/src/platform/macos/openbot_setup.mm
new file mode 100644
index 00000000..ba08c80e
--- /dev/null
+++ b/src/platform/macos/openbot_setup.mm
@@ -0,0 +1,176 @@
+// OpenBot additions to Sunshine, distributed under GPL-3.0.
+#import <AppKit/AppKit.h>
+#import <CoreGraphics/CoreGraphics.h>
+#include <mutex>
+#include <unistd.h>
+#include "openbot_setup.h"
+#include "misc.h"
+
+namespace {
+  std::mutex input_mutex;
+  bool test_mode = false;
+  int64_t event_tag = 0;
+  CGRect test_bounds = CGRectZero;
+  bool clicked = false;
+  bool typed = false;
+  NSString *code = @"";
+  NSString *entered = @"";
+  NSWindow *panel = nil;
+  NSDate *expires = nil;
+  void on_main(void (^operation)()) {
+    if (NSThread.isMainThread) operation();
+    else dispatch_sync(dispatch_get_main_queue(), operation);
+  }
+}
+
+@interface OpenBotTestView : NSView
+@end
+@implementation OpenBotTestView
+- (BOOL)acceptsFirstResponder { return YES; }
+- (void)drawRect:(NSRect)dirtyRect {
+  [[NSColor windowBackgroundColor] setFill];
+  NSRectFill(self.bounds);
+  NSDictionary *attributes = @{NSFontAttributeName: [NSFont systemFontOfSize:20], NSForegroundColorAttributeName: [NSColor labelColor]};
+  [@"OpenBot remote desktop test" drawAtPoint:NSMakePoint(24, 240) withAttributes:attributes];
+  [@"Click the target through the remote connection." drawAtPoint:NSMakePoint(24, 198) withAttributes:attributes];
+  [[NSColor controlAccentColor] setFill];
+  NSRectFill(NSMakeRect(24, 110, 390, 60));
+  [(clicked ? @"Mouse received" : @"Click here") drawAtPoint:NSMakePoint(40, 128) withAttributes:attributes];
+  [[NSString stringWithFormat:@"Then type: %@", code] drawAtPoint:NSMakePoint(24, 70) withAttributes:attributes];
+  [(typed ? @"Keyboard received" : [NSString stringWithFormat:@"Input: %@", entered]) drawAtPoint:NSMakePoint(24, 30) withAttributes:attributes];
+}
+- (BOOL)remoteEvent:(NSEvent *)event {
+  CGEventRef native = event.CGEvent;
+  std::lock_guard<std::mutex> lock(input_mutex);
+  return test_mode && native && CGEventGetIntegerValueField(native, kCGEventSourceUserData) == event_tag &&
+    CGEventGetIntegerValueField(native, kCGEventSourceUnixProcessID) == getpid();
+}
+- (void)acceptMouse:(NSEvent *)event point:(NSPoint)point {
+  if ([self remoteEvent:event] && NSPointInRect(point, NSMakeRect(24, 110, 390, 60))) {
+    clicked = true;
+    [self.window makeFirstResponder:self];
+    self.needsDisplay = YES;
+  }
+}
+- (void)mouseDown:(NSEvent *)event {
+  [self acceptMouse:event point:[self convertPoint:event.locationInWindow fromView:nil]];
+}
+- (void)acceptKey:(NSEvent *)event characters:(NSString *)characters {
+  if (![self remoteEvent:event] || !clicked) return;
+  if (characters.length != 1 || [characters rangeOfCharacterFromSet:[[NSCharacterSet decimalDigitCharacterSet] invertedSet]].location != NSNotFound) return;
+  entered = [entered stringByAppendingString:characters];
+  if (entered.length > 4) entered = [entered substringFromIndex:entered.length - 4];
+  typed = [entered isEqualToString:code];
+  self.needsDisplay = YES;
+}
+- (void)keyDown:(NSEvent *)event {
+  [self acceptKey:event characters:event.charactersIgnoringModifiers];
+}
+@end
+
+namespace platf {
+  nlohmann::json openbot_setup_status() {
+    auto session = CGSessionCopyCurrentDictionary();
+    bool gui = false;
+    if (session) {
+      auto uid = (CFNumberRef) CFDictionaryGetValue(session, kCGSessionUserIDKey);
+      int session_uid = -1;
+      if (uid) CFNumberGetValue(uid, kCFNumberIntType, &session_uid);
+      gui = session_uid == getuid() && CFDictionaryGetValue(session, kCGSessionOnConsoleKey) == kCFBooleanTrue;
+      CFRelease(session);
+    }
+    uint32_t count = 0;
+    auto display_result = CGGetActiveDisplayList(0, nullptr, &count);
+    const bool capture = CGPreflightScreenCaptureAccess();
+    return {{"screenRecording", capture ? "allowed" : "blocked"},
+      {"accessibility", AXIsProcessTrusted() ? "allowed" : "blocked"},
+      {"guiSession", gui ? "allowed" : "blocked"},
+      {"displays", display_result == kCGErrorSuccess ? (count > 0 ? "allowed" : "unavailable") : "failed"},
+      {"restartRequired", capture && !is_screen_capture_allowed()},
+      {"username", std::string([NSUserName() UTF8String])},
+      {"hostName", std::string([NSProcessInfo.processInfo.hostName UTF8String])}};
+  }
+
+  nlohmann::json openbot_test_status() {
+    __block nlohmann::json result;
+    on_main(^{
+      result = {{"active", panel != nil && panel.visible}, {"mouse", clicked}, {"keyboard", typed}, {"code", std::string([code UTF8String])}};
+    });
+    return result;
+  }
+
+  void openbot_test_action(const std::string &action, const std::string &display_id) {
+    on_main(^{
+      if (action == "stop") {
+        [panel close];
+        panel = nil;
+        expires = nil;
+        std::lock_guard<std::mutex> lock(input_mutex);
+        test_mode = false;
+        event_tag = 0;
+        return;
+      }
+      if (panel) return;
+      code = [NSString stringWithFormat:@"%04u", arc4random_uniform(10000)];
+      entered = @"";
+      clicked = typed = false;
+      panel = [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, 480, 290) styleMask:NSWindowStyleMaskTitled backing:NSBackingStoreBuffered defer:NO];
+      panel.releasedWhenClosed = NO;
+      panel.title = @"OpenBot remote desktop test";
+      panel.level = NSFloatingWindowLevel;
+      panel.contentView = [[OpenBotTestView alloc] initWithFrame:NSMakeRect(0, 0, 480, 290)];
+      NSScreen *target = NSScreen.screens.firstObject;
+      for (NSScreen *screen in NSScreen.screens) {
+        if (std::string([screen.deviceDescription[@"NSScreenNumber"] stringValue].UTF8String) == display_id) target = screen;
+      }
+      [panel setFrameOrigin:NSMakePoint(NSMidX(target.frame) - panel.frame.size.width / 2, NSMidY(target.frame) - panel.frame.size.height / 2)];
+      [panel makeKeyAndOrderFront:nil];
+      [panel makeFirstResponder:panel.contentView];
+      [NSApp activateIgnoringOtherApps:YES];
+      expires = [NSDate dateWithTimeIntervalSinceNow:120];
+      std::lock_guard<std::mutex> lock(input_mutex);
+      event_tag = ((int64_t)arc4random() << 20) | arc4random_uniform(1 << 20);
+      const auto frame = panel.frame;
+      const auto main_height = NSScreen.screens.firstObject.frame.size.height;
+      test_bounds = CGRectMake(frame.origin.x, main_height - NSMaxY(frame), frame.size.width, frame.size.height);
+      test_mode = true;
+    });
+  }
+
+  bool openbot_test_input(CGEventRef event) {
+    std::lock_guard<std::mutex> lock(input_mutex);
+    if (!test_mode) return false;
+    auto type = CGEventGetType(event);
+    if (type == kCGEventKeyDown || type == kCGEventKeyUp) {
+      auto key = CGEventGetIntegerValueField(event, kCGKeyboardEventKeycode);
+      // Only the ten digit keys; shortcuts cannot reach another application.
+      if (key != 18 && key != 19 && key != 20 && key != 21 && key != 23 && key != 22 && key != 26 && key != 28 && key != 25 && key != 29) return true;
+    } else if (type == kCGEventLeftMouseDown || type == kCGEventLeftMouseUp || type == kCGEventMouseMoved) {
+      if (!CGRectContainsPoint(test_bounds, CGEventGetLocation(event))) return true;
+    } else return true;
+    CGEventSetFlags(event, 0);
+    CGEventSetIntegerValueField(event, kCGEventSourceUserData, event_tag);
+    CGEventPostToPid(getpid(), event);
+    return true;
+  }
+
+  void openbot_main_loop(const std::function<bool()> &stopped) {
+    @autoreleasepool {
+      [NSApplication sharedApplication];
+      [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+      [NSApp finishLaunching];
+      while (!stopped()) {
+        @autoreleasepool {
+          NSEvent *event = [NSApp nextEventMatchingMask:NSEventMaskAny untilDate:[NSDate dateWithTimeIntervalSinceNow:0.1] inMode:NSDefaultRunLoopMode dequeue:YES];
+          if (event) [NSApp sendEvent:event];
+          [NSApp updateWindows];
+          if (expires && expires.timeIntervalSinceNow <= 0) {
+            [panel close];
+            expires = nil;
+          }
+        }
+      }
+      [panel close];
+    }
+  }
+}
