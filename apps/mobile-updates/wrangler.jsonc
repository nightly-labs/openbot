{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbot-mobile-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "updates.openbot.run",
      "custom_domain": true
    }
  ],
  // Workers Logs stay off, as for the account service. A request also has the last fatal error text of
  // the app in a header, and invocation logs record request headers. `wrangler tail` shows live events.
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "UPDATES",
      "bucket_name": "openbot-mobile-updates",
      "preview_bucket_name": "openbot-mobile-updates-test"
    }
  ]
}
