{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbot-email-relay",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/email-relay-entry.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "placement": {
    "host": "mail.privateemail.com:465"
  }
}
