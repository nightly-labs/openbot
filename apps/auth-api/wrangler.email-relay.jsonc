// The email relay Worker. The production account Worker (`wrangler.jsonc`) sends email through it over
// the `EMAIL_RELAY` service binding, so deploy this Worker first. See `src/email-relay-entry.ts`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbot-email-relay",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/email-relay-entry.ts",
  // Only the service binding reaches the relay.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs stay off, as for the production Worker. `wrangler tail` still shows live events.
  "observability": {
    "enabled": false
  },
  // Runs the relay near the mail host, and not near the caller. Keep it equal to EMAIL_SMTP_HOST and
  // EMAIL_SMTP_PORT in `wrangler.jsonc`.
  "placement": {
    "host": "mail.privateemail.com:465"
  }
}
