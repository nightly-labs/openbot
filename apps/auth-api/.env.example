AUTH_EXPOSE_DEVELOPMENT_CODE=true
# All five or none. Development leaves them blank so nothing sends mail locally.
EMAIL_SMTP_HOST=mail.privateemail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=hello@openbot.run
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=hello@openbot.run
EMAIL_DELIVERY_WEBHOOK_URL= # optional
EMAIL_DELIVERY_WEBHOOK_SECRET= # optional
SKILLS_ADMIN_TOKEN=
SERVER_CLAIMS_ADMIN_TOKEN= # optional: the operator token for /v2/admin/server-claims
SITE_REPORT_HASH_SECRET= # at least 32 random characters
SITE_PUBLISH_ENABLED=false
SITE_COOKIE_ISOLATION_READY=false
REMOTE_TICKET_PRIVATE_JWK=
REMOTE_TICKET_PUBLIC_JWKS=
REMOTE_TICKET_KEY_ID=openbot-remote-1
REMOTE_SIGNAL_URL=wss://signal.openbot.run/v1/signal
# optional: the Signal machines that a host can have as its home, as id=url,id=url. Empty = each host uses REMOTE_SIGNAL_URL.
REMOTE_SIGNAL_HOMES= # for example a=wss://signal-a.openbot.run/v1/signal,b=wss://signal-b.openbot.run/v1/signal
REMOTE_AUTH_WEBHOOK_URL=https://signal.openbot.run/internal/auth-events
# optional: each Signal that gets the auth events, as url,url. Empty = only REMOTE_AUTH_WEBHOOK_URL.
REMOTE_AUTH_WEBHOOK_URLS=
REMOTE_AUTH_WEBHOOK_SECRET=
# optional: the Telegram routes answer 503 without the OpenBot bot. The route ticket uses SLACK_ROUTE_*.
TELEGRAM_BOT_ID= # the part of the bot token before the colon; never the token
TELEGRAM_BOT_USERNAME= # without @
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
GITHUB_APP_PRIVATE_KEY= # optional, PKCS #8 PEM of the OpenBot GitHub App
# optional: the Live Activity relay is off without an Apple Push Notification service key
APNS_PRIVATE_KEY= # the .p8 key text, with its BEGIN and END lines
APNS_KEY_ID=
APNS_TEAM_ID=ZTRDTUL87R
APNS_TOPIC=run.openbot.mobile
# optional: the Android notification relay is off without a Firebase service account key
FCM_SERVICE_ACCOUNT= # the service account key file from Firebase, as one line of JSON
