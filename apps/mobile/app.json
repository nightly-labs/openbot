{
  "expo": {
    "name": "OpenBot",
    "slug": "openbot",
    "platforms": ["ios", "android"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "openbot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "run.openbot.mobile",
      "associatedDomains": ["applinks:openbot.run"],
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow OpenBot to connect to your desktop during local development.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icons/app-icon.icon"
    },
    "android": {
      "package": "run.openbot.mobile",
      "icon": "./assets/icons/app-icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "./plugins/with-rocketsim",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6C5FA",
          "image": "./assets/icons/app-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181818"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OpenBot to use your camera to scan QR codes.",
          "microphonePermission": "Allow OpenBot to use the microphone to dictate messages.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OpenBot to access the photos you choose to share.",
          "cameraPermission": "Allow OpenBot to use your camera to add photos.",
          "microphonePermission": "Allow OpenBot to use the microphone to dictate messages."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OpenBot to access the photos you choose to share.",
          "savePhotosPermission": "Allow OpenBot to save images you download from a chat to your photo library.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow OpenBot to react to how you rotate your device."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow OpenBot to use the microphone to dictate messages.",
          "speechRecognitionPermission": "Allow OpenBot to turn your speech into message text."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "run.openbot.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.run.openbot.mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eeec730f-c8f4-42c0-a750-64df8af14940"
      }
    },
    "owner": "openbot",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/eeec730f-c8f4-42c0-a750-64df8af14940"
    }
  }
}
