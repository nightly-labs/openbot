#!/bin/sh
set -eu

# Git gives a hook GIT_DIR but not GIT_WORK_TREE. In a linked worktree GIT_DIR points at the
# worktree's own git directory, so git takes the current directory as the top of the working tree.
# After the hook changes into a project subdirectory, `git add -- <path>` would then stage the file
# under a second path, relative to that subdirectory. Without both variables git finds the working
# tree itself, as in a normal checkout. GIT_INDEX_FILE stays: the hook must use the same index.
unset GIT_DIR GIT_WORK_TREE

# The project is the directory that holds this hook's .githooks. It is the repository root in a
# normal checkout, and a subdirectory when OpenBot is checked out inside a larger repository.
repository_root=$(cd -- "$(git rev-parse --show-toplevel)" && pwd -P)
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
project_path=""
case "$project_root" in
  "$repository_root"/*) project_path=${project_root#"$repository_root"/} ;;
  *) project_root="$repository_root" ;;
esac
cd "$project_root"

git_diff() {
  if [ -n "$project_path" ]; then
    git -C "$repository_root" -c core.quotePath=false diff "$@" --relative="$project_path" -- "$project_path"
  else
    git -c core.quotePath=false diff "$@"
  fi
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Biome fixes the working-tree copy, and staging that copy again would also stage the edits the
# author left unstaged. Only fully staged files are staged again; a partly staged file that Biome
# changes stops the commit so the author can choose which fixes to stage.
git_diff --cached --name-only --diff-filter=ACMR >"$work/staged"
git_diff --name-only >"$work/unstaged"
grep -Fx -f "$work/unstaged" "$work/staged" >"$work/partly-staged" || true
grep -Fxv -f "$work/partly-staged" "$work/staged" >"$work/fully-staged" || true

hash_partly_staged() {
  while IFS= read -r path; do
    printf '%s %s\n' "$(git hash-object -- "$path" 2>/dev/null || echo missing)" "$path"
  done <"$work/partly-staged"
}

hash_partly_staged >"$work/before"
echo "Running staged format and lint checks..."
bun run check:staged
hash_partly_staged >"$work/after"

if [ -s "$work/fully-staged" ]; then
  tr '\n' '\0' <"$work/fully-staged" | xargs -0 git add --
fi

if ! cmp -s "$work/before" "$work/after"; then
  echo "Biome fixed files that also have unstaged changes:" >&2
  diff "$work/before" "$work/after" | sed -n 's/^> [^ ]* /  /p' >&2
  echo "Stage the fixes you want to commit, then commit again." >&2
  exit 1
fi

staged_paths=$(git_diff --cached --name-only --diff-filter=ACMRD)

# A version bump is a release: its CHANGELOG.md section is the /changelog page. It runs first
# because it takes less time than the type checks.
if printf '%s\n' "$staged_paths" | grep -Fxq package.json; then
  echo "Checking the release notes..."
  bun scripts/check-release-notes.ts --staged
fi

# The iPhone app has its own version, in app.json, and its own notes: the Mobile tab of /changelog.
if printf '%s\n' "$staged_paths" | grep -Fxq apps/mobile/app.json; then
  echo "Checking the mobile release notes..."
  bun scripts/check-release-notes.ts --staged --mobile
fi

# The release copies each fragment into its changelog, so a malformed one stops it later.
if [ -n "$project_path" ]; then
  git -C "$repository_root" -c core.quotePath=false diff --cached --name-only -z --diff-filter=ACMR \
    --relative="$project_path" -- "$project_path/changelog.d/*.md" "$project_path/apps/mobile/changelog.d/*.md" \
    ":(exclude)$project_path/changelog.d/README.md" ":(exclude)$project_path/apps/mobile/changelog.d/README.md"
else
  git diff --cached --name-only -z --diff-filter=ACMR -- 'changelog.d/*.md' 'apps/mobile/changelog.d/*.md' \
    ':(exclude)changelog.d/README.md' ':(exclude)apps/mobile/changelog.d/README.md'
fi |
  xargs -0 -r bun scripts/check-release-notes.ts --staged --fragments

# Text-only commits, such as docs and AGENTS.md, cannot change a type or a UI rule. Data JSON is
# not code; `apps/mobile/app.json` is, because the mobile codegen reads it.
code_pattern='\.(ts|tsx|mts|cts|js|mjs|cjs|css|grit)$|(^|/)(tsconfig[^/]*|package|biome)\.json$|^apps/mobile/app\.json$|(^|/)bun\.lock$'
if printf '%s\n' "$staged_paths" | grep -Eq "$code_pattern"; then
  echo "Running UI foundation check..."
  bun run check:ui

  # Only the projects that can see a staged file, one at a time. CI checks all of them.
  echo "Running type checks..."
  bun scripts/staged-typecheck.ts
else
  echo "Skipping UI and type checks: no staged code, style, or configuration files."
fi

# Migrations cannot be undone on a user's computer, so a schema change runs its parity test here.
schema_pattern='^src/backend/(openbot-database-schema|openbot-database-schema-parity\.test|channel-schema|mcp-schema)\.ts$|^src/backend/openbot-database-schema-history\.json$'
if printf '%s\n' "$staged_paths" | grep -Eq "$schema_pattern"; then
  echo "Running the database schema parity test..."
  bun run test:desktop -- src/backend/openbot-database-schema-parity.test.ts
fi
