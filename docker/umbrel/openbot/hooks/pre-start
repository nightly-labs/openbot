#!/usr/bin/env bash
# The AppArmor profile below is derived from moby/profiles (apparmor/template.go,
# commit 6fe7deb1b9fb7c0397a4593480d7d22b9ee8caef), Copyright The Moby Authors,
# licensed under the Apache License, Version 2.0 (see APACHE-2.0.txt).
# Modified to set abi/4.0, permit userns, and rely on peer=unconfined for dockerd.
set -euo pipefail

DATA_DIR="${APP_DATA_ROOT:-${APP_DATA_DIR}/data}"

mkdir -p "${DATA_DIR}"
if [[ "$(stat -c '%u:%g' "${DATA_DIR}")" != "1000:1000" ]]; then
  chown 1000:1000 "${DATA_DIR}"
fi
chmod 0700 "${DATA_DIR}"

find_apparmor_parser() {
  if command -v apparmor_parser >/dev/null 2>&1; then
    command -v apparmor_parser
  elif [[ -x /usr/sbin/apparmor_parser ]]; then
    echo /usr/sbin/apparmor_parser
  elif [[ -x /sbin/apparmor_parser ]]; then
    echo /sbin/apparmor_parser
  fi
}

load_apparmor_profile() {
  local parser
  [[ -e /sys/kernel/security/apparmor/profiles ]] || return 0
  [[ -e /etc/apparmor.d/abi/4.0 ]] || return 0
  parser="$(find_apparmor_parser)"
  [[ -n "${parser}" ]] || return 0

  "${parser}" --replace --skip-cache <<'EOF' || echo "OpenBot AppArmor profile did not load." >&2
abi <abi/4.0>,
include <tunables/global>

profile docker-__APP_ID__ flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  userns,

  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=docker-__APP_ID__,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=docker-__APP_ID__,
}
EOF
}

load_apparmor_profile
