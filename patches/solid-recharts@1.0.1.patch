+// Solid 2 adapter for the published Solid 1 chart sources. Uses the host runtime only.
+export * from "solid-js";
+import * as solid from "solid-js";
+export function onMount(fn) {
+  const owner = solid.getOwner();
+  solid.onSettled(() => solid.runWithOwner(owner, () => solid.untrack(fn)));
+}
+export function batch(fn) { return fn(); }
+export function createSignal(value, options) { return solid.createSignal(value, { ...options, ownedWrite: true }); }
+export function createMemo(fn, initial, options) { return solid.createMemo(fn, { ...options, sync: true }); }
+export function createStore(value) {
+  const [state, setState] = solid.createStore(value);
+  return [state, fn => solid.runWithOwner(null, () => setState(fn))];
+}
+export function produce(fn) { return fn; }
+export function splitProps(props, ...groups) {
+  const keys = groups.flat();
+  return [...groups.map(group => Object.defineProperties({}, Object.fromEntries(group.filter(key => key in props).map(key => [key, { enumerable: true, get: () => props[key] }])))), solid.omit(props, ...keys)];
+}
+export function createContext(value = null) {
+  const context = solid.createContext(value);
+  context.Provider = context;
+  return context;
+}
+export function useContext(context) { return solid.useContext(context) ?? undefined; }
+export function on(deps, apply, options) { return { deps, apply, options }; }
+// Solid 1 effects retain context and permit owned children and cleanup registration.
+export function createEffect(effect) {
+  const owner = solid.getOwner();
+  let previous;
+  let first = true;
+  solid.createEffect(() => Array.isArray(effect.deps) ? effect.deps.map(fn => fn()) : effect.deps(), value => {
+    if (first && effect.options?.defer) { first = false; previous = value; return; }
+    first = false;
+    return solid.runWithOwner(owner, () => solid.createRoot(dispose => {
+      const cleanup = solid.untrack(() => effect.apply(value, previous));
+      previous = value;
+      if (typeof cleanup === "function") solid.onCleanup(cleanup);
+      return dispose;
+    }));
+  });
+}
+export function Index(props) {
+  return solid.For({ get each() { return props.each; }, keyed: false, get fallback() { return props.fallback; }, children: props.children });
+}
+
+// Solid 1 props use the last defined value; Solid 2 merge preserves explicit undefined.
+export function mergeProps(...sources) {
+  const resolve = source => typeof source === "function" ? source() : source;
