+export * from "@solidjs/web";
+export { applyRef as use } from "@solidjs/web";
+import { createRenderEffect } from "solid-js";
+// Solid 1's compiled DOM effects combine dependency reads and DOM assignments.
+export function effect(fn, initial) {
+  let previous = initial;
+  createRenderEffect(() => fn(previous), value => { previous = value; });
+}
+import { template as domTemplate } from "@solidjs/web";
+export function template(html, customElement, svg) { return domTemplate(html, svg ? 2 : customElement ? 1 : undefined); }
+
+export { mergeProps } from "./solid2.js";
+
+// Solid 1 compiled child expressions create components; retain an owned scope.
+import { insert as domInsert, spread as domSpread } from "@solidjs/web";
+export function insert(parent, accessor, marker, initial) {
+  return domInsert(parent, accessor, marker, initial, { scope: true });
+}
+export function spread(node, props, isSVG, skipChildren) {
+  if (!skipChildren) insert(node, () => props.children);
+  return domSpread(node, props, true);
+}
