     const auto textLayoutManager = std::make_shared<const TextLayoutManager>(getContextContainer());
 
-    return textLayoutManager->measure(
+    auto size = textLayoutManager->measure(
       AttributedStringBox{content.attributedString},
       paragraphAttributes,
       textLayoutContext,
       layoutConstraints
     ).size;
+
+    // React Native gives text that wraps the full available width. The text
+    // view takes the width of its widest line instead, so a bubble around it
+    // ends where its text ends.
+    const auto maximumWidth = layoutConstraints.maximumSize.width;
+    if (std::isfinite(maximumWidth) && size.width >= maximumWidth) {
+      const auto lines = textLayoutManager->measureLines(
+        AttributedStringBox{content.attributedString},
+        paragraphAttributes,
+        Size{maximumWidth, std::numeric_limits<Float>::infinity()}
+      );
+      Float widest = 0;
+      for (const auto &line : lines) {
+        widest = std::max(widest, line.frame.origin.x + line.frame.size.width);
+      }
+      if (widest > 0) {
+        const auto fitted = roundToPixel<&ceil>(
+          Size{widest + 0.01f, size.height}, layoutContext.pointScaleFactor);
+        size.width = std::min(size.width, std::max(fitted.width, layoutConstraints.minimumSize.width));
+      }
+    }
+    return size;
 }
 
