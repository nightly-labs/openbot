+private const val MAX_SVG_BITMAP_PIXELS = 4_194_304.0
+
+private fun rasterize(picture: Picture): Bitmap {
+  val pictureWidth = max(1, picture.width)
+  val pictureHeight = max(1, picture.height)
+  val downscale = min(1.0, sqrt(MAX_SVG_BITMAP_PIXELS / (pictureWidth.toDouble() * pictureHeight)))
+  val bitmap = Bitmap.createBitmap(
+    max(1, (pictureWidth * downscale).toInt()),
+    max(1, (pictureHeight * downscale).toInt()),
+    Bitmap.Config.ARGB_8888
+  )
+  val canvas = Canvas(bitmap)
+  canvas.scale(downscale.toFloat(), downscale.toFloat())
+  canvas.drawPicture(picture)
+  return bitmap
+}
